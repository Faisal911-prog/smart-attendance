# Copy to ".env" (development) or set these in the hosting dashboard (production).

# Base URL of the Django backend WITHOUT a trailing slash and without "/api".
# Leave empty in development: the Vite dev server proxies /api to Django.
# On Render: https://your-backend.onrender.com
VITE_API_URL=

# "true" shows a panel on the check-in page that lets you type test coordinates
# instead of using the phone's GPS. For demos on a laptop without a phone ONLY;
# never enable it on a real deployment.
VITE_DEMO_MODE=false
