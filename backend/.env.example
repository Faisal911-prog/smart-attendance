# Copy this file to ".env" and adjust the values.
# Never commit the real .env file (it is listed in .gitignore).

# --- Core -------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------
# Leave empty to use a local SQLite file (easiest for development / demo).
# For PostgreSQL use e.g.:
#   DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance
# Hosted databases (Neon, Supabase, ...) usually need "?sslmode=require" at the end.
DATABASE_URL=

# --- Front-end / CORS -------------------------------------------------
# URL of the React app. It is embedded in the QR codes, so students' phones
# must be able to open it (use the public https:// address when deployed).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# --- JWT --------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=1

# --- Attendance rules -------------------------------------------------
# A QR token is accepted for its own time window plus this many older windows.
QR_GRACE_WINDOWS=1
# Fixed upper limit for the GPS accuracy (metres) a phone may report.
MAX_GPS_ACCURACY_M=100

# --- Demo data --------------------------------------------------------
DEMO_PASSWORD=Demo1234!
